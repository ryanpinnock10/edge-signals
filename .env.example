# Edge Signals — environment variables
# Copy to .env and fill in. .env is gitignored; never commit real values.

# Port the production server listens on (default 5000)
PORT=5000

# --- Optional: only needed if you wire up automated alert email delivery ---
# Email address that receives triggered alert notifications.
ALERT_NOTIFY_EMAIL=

# Resend API key for sending alert emails (if using Resend for delivery).
# RESEND_API_KEY=
